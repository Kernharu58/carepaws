# --- Core ---
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000

# --- Database ---
MONGO_URI=mongodb://localhost:27017/carepaws

# --- Auth ---
JWT_SECRET=replace-with-a-random-32-char-minimum-secret
JWT_EXPIRES_IN=7d
# Production hardening (see §5.1 / §11.6): short-lived access token + rotating refresh token
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_SIZE=10485760

# --- Google OAuth (three separate client IDs — native SDK requires per-platform IDs) ---
GOOGLE_CLIENT_ID=
ANDROID_CLIENT_ID=
IOS_CLIENT_ID=

# --- Email: EITHER the Gmail-style trio OR the generic SMTP trio. Neither configured = emailSkipped:true. ---
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=

# --- Payments (PayMongo) ---
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Frontends ---
FRONTEND_URL=http://localhost:5173,http://localhost:3000
MOBILE_APP_URL=carepaws://

# --- Production additions (not in the original source .env.example) ---
REDIS_URL=redis://localhost:6379
SENTRY_DSN=
LOG_LEVEL=info
MAINTENANCE_CACHE_TTL_MS=10000
